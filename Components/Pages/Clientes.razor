@page "/clientes"
@rendermode InteractiveServer
@inject IClienteApiService ClienteApi

<PageTitle>Clientes</PageTitle>

<h1 class="mb-4">Administración de Clientes</h1>

@if (mensajeExito is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @mensajeExito
        <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
    </div>
}

@if (errorGeneral is not null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorGeneral
        <button type="button" class="btn-close" @onclick="() => errorGeneral = null"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-primary" @onclick="AbrirModalNuevo">
        + Nuevo cliente
    </button>
    <button class="btn btn-outline-secondary" @onclick="CargarClientesAsync">
        Actualizar listado
    </button>
</div>

@if (cargando)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Cargando clientes...</p>
    </div>
}
else if (clientes.Count == 0)
{
    <div class="alert alert-info">No hay clientes registrados todavía.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>CUI</th>
                    <th>NIT</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Fecha nacimiento</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in clientes)
                {
                    <tr>
                        <td>@cliente.IdCliente</td>
                        <td>@cliente.Cui</td>
                        <td>@cliente.Nit</td>
                        <td>@cliente.Nombres</td>
                        <td>@cliente.Apellidos</td>
                        <td>@cliente.Direccion</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AbrirModalEditar(cliente)">
                                Editar
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => AbrirModalEliminar(cliente)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ===================== MODAL: Crear / Editar ===================== *@
@if (mostrarModalFormulario)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <EditForm Model="formulario" OnValidSubmit="GuardarClienteAsync">
                    <DataAnnotationsValidator />

                    <div class="modal-header">
                        <h5 class="modal-title">
                            @(idEnEdicion is null ? "Nuevo cliente" : "Editar cliente")
                        </h5>
                        <button type="button" class="btn-close" @onclick="CerrarModalFormulario"></button>
                    </div>

                    <div class="modal-body">
                        @if (errorFormulario is not null)
                        {
                            <div class="alert alert-danger">@errorFormulario</div>
                        }

                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">CUI</label>
                            <InputText class="form-control" @bind-Value="formulario.Cui" maxlength="13" />
                            <ValidationMessage For="() => formulario.Cui" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">NIT</label>
                            <InputText class="form-control" @bind-Value="formulario.Nit" />
                            <ValidationMessage For="() => formulario.Nit" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Nombres</label>
                            <InputText class="form-control" @bind-Value="formulario.Nombres" />
                            <ValidationMessage For="() => formulario.Nombres" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Apellidos</label>
                            <InputText class="form-control" @bind-Value="formulario.Apellidos" />
                            <ValidationMessage For="() => formulario.Apellidos" class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Dirección</label>
                            <InputText class="form-control" @bind-Value="formulario.Direccion" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <InputText class="form-control" @bind-Value="formulario.Telefono" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Fecha de nacimiento</label>
                            <InputDate class="form-control" @bind-Value="formulario.FechaNacimiento" />
                            <ValidationMessage For="() => formulario.FechaNacimiento" class="text-danger small" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModalFormulario">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@* ===================== MODAL: Confirmar eliminación ===================== *@
@if (clienteAEliminar is not null)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body">
                    @if (errorEliminar is not null)
                    {
                        <div class="alert alert-danger">@errorEliminar</div>
                    }
                    <p>
                        ¿Seguro que deseas eliminar al cliente
                        <strong>@clienteAEliminar.Nombres @clienteAEliminar.Apellidos</strong>
                        (CUI: @clienteAEliminar.Cui)?
                    </p>
                    <p class="text-muted small">Esta acción no se puede deshacer.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarEliminarAsync" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<ClienteDto> clientes = new();
    private bool cargando = true;
    private string? errorGeneral;
    private string? mensajeExito;

    // --- Estado del modal de crear/editar ---
    private bool mostrarModalFormulario;
    private ClienteFormModel formulario = new();
    private int? idEnEdicion;
    private string? errorFormulario;
    private bool guardando;

    // --- Estado del modal de eliminar ---
    private ClienteDto? clienteAEliminar;
    private string? errorEliminar;
    private bool eliminando;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientesAsync();
    }

    private async Task CargarClientesAsync()
    {
        cargando = true;
        errorGeneral = null;
        try
        {
            clientes = await ClienteApi.ObtenerClientesAsync();
        }
        catch (ApiException ex)
        {
            errorGeneral = $"No se pudo cargar el listado de clientes: {ex.Message}";
        }
        catch (HttpRequestException)
        {
            errorGeneral = "No se pudo conectar con la API. Verifica que ClientesApi esté en ejecución.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        idEnEdicion = null;
        formulario = new ClienteFormModel();
        errorFormulario = null;
        mostrarModalFormulario = true;
    }

    private void AbrirModalEditar(ClienteDto cliente)
    {
        idEnEdicion = cliente.IdCliente;
        formulario = new ClienteFormModel
        {
            Cui = cliente.Cui,
            Nit = cliente.Nit,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            FechaNacimiento = cliente.FechaNacimiento
        };
        errorFormulario = null;
        mostrarModalFormulario = true;
    }

    private void CerrarModalFormulario()
    {
        mostrarModalFormulario = false;
        errorFormulario = null;
    }

    private async Task GuardarClienteAsync()
    {
        guardando = true;
        errorFormulario = null;
        try
        {
            if (idEnEdicion is null)
            {
                await ClienteApi.CrearClienteAsync(formulario);
                mensajeExito = "Cliente creado correctamente.";
            }
            else
            {
                await ClienteApi.ActualizarClienteAsync(idEnEdicion.Value, formulario);
                mensajeExito = "Cliente actualizado correctamente.";
            }

            mostrarModalFormulario = false;
            await CargarClientesAsync(); // refresca el listado tras la operación
        }
        catch (ApiException ex)
        {
            errorFormulario = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorFormulario = "No se pudo conectar con la API. Verifica que ClientesApi esté en ejecución.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void AbrirModalEliminar(ClienteDto cliente)
    {
        clienteAEliminar = cliente;
        errorEliminar = null;
    }

    private void CerrarModalEliminar()
    {
        clienteAEliminar = null;
        errorEliminar = null;
    }

    private async Task ConfirmarEliminarAsync()
    {
        if (clienteAEliminar is null)
        {
            return;
        }

        eliminando = true;
        errorEliminar = null;
        try
        {
            await ClienteApi.EliminarClienteAsync(clienteAEliminar.IdCliente);
            mensajeExito = "Cliente eliminado correctamente.";
            clienteAEliminar = null;
            await CargarClientesAsync(); // refresca el listado tras eliminar
        }
        catch (ApiException ex)
        {
            errorEliminar = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorEliminar = "No se pudo conectar con la API. Verifica que ClientesApi esté en ejecución.";
        }
        finally
        {
            eliminando = false;
        }
    }
}
